@party
title: Party Affairs
card-image: img/Vorwaerts_nr_1.png
is-deck: true

- #party_affairs

@inter_party_affairs
title: Party Affairs
card-image: img/inter_party_relations.jpg
is-deck: true

- #inter_party_affairs

@govt
title: Government Affairs
view-if: time >= 6 or spd_in_government
card-image: img/reichstag_2.jpg
is-deck: true

- #govt_affairs

@cabinet
title: Cabinet Affairs
view-if: time >= 6 or spd_in_government
card-image: img/reichstag_2.jpg
is-deck: true

- #cabinet_affairs

@landtag_affairs
title: Landtags
card-image: img/reichstag_2.jpg
is-deck: true

- #landtag_affairs

@pres
title: Presidential Affairs
view-if: president == "Ebert" or president == "Braun" or president == "Schumacher" or president == "Juchacz"
card-image: img/presidential_affairs.jpg
is-deck: true

- #pres_affairs
