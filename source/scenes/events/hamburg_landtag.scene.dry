            "name": "NSDAP",
            "seats": Math.round(Q.nsdap_hl*1.6),
        },
    ];
}
if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

= Election results

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#E3000F; outline: 2px; outline-style: solid;'> </div> !} **SPD:** {!</td><td>!} **[+ spd_hl +]%** {!</td><td>!} **[+ sthl_change_spd +]** {!</td></tr>!}

[? if sapd_formed == 1 : {!<tr><td><div class="box" style='background-color:#C40000'> </div> !}SAPD: {!</td><td>!} [+ sapd_hl +]% {!</td><td>!} [+ sthl_change_sapd +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#8B0000'> </div> !}USPD: {!</td><td>!} [+ uspd_hl +]% {!</td><td>!} [+ sthl_change_uspd +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#DCCA4A'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_hl +]% {!</td><td>!} [+ sthl_change_ddp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#000'> </div> !} Z: {!</td><td>!} [+ z_hl +]% {!</td><td>!} [+ sthl_change_z +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#D5AC27'> </div> !} DVP: {!</td><td>!} [+ dvp_hl +]% {!</td><td>!} [+ sthl_change_dvp +] {!</td></tr>!}
 
{!<tr><td><div class="box" style='background-color:#a0a0a0'> </div> !} Others: {!</td><td>!} [+ other_hl +] % {!</td><td>!} [+ sthl_change_other +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#3f7bc1'> </div> !} DNVP: {!</td><td>!} [+ dnvp_hl +]% {!</td><td>!} [+ sthl_change_dnvp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#954B00'> </div> !} NSDAP: {!</td><td>!} [+ nsdap_hl +]% {!</td><td>!} [+ sthl_change_nsdap +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Left Coalition (SPD + USPD): [+ h_left_coalition +] 

USPD-tolerated SPD Minority ((SPD alone): [+ h_uspd_tolerated_spd_minority +]%;

USPD-tolerated Social-Liberal Coalition (SPD + [+ ddp_name +]): [+ h_uspd_tolerated_social_liberal_coalition +]% 

Social-Liberal Coalition (SPD + [+ ddp_name +]): [+ h_social_liberal_coalition +]%

Social-Christian Coalition (SPD + Z): [+ h_social_christian_coalition +]%

USPD-tolerated Weimar Coalition (SPD + Z + [+ ddp_name +]): [+ h_uspd_tolerated_weimar_coalition +]%

Weimar Coalition (SPD + Z + [+ ddp_name +]): [+ h_weimar_coalition +]%

Grand Coalition (SPD + Z + [+ ddp_name +] + DVP): [+ h_grand_coalition +]%

Bourgeois Coalition (Z + [+ ddp_name +] + DVP + Others): [+ h_bourgeois_coalition +]%

Right-wing Coalition (Z + DVP + Others + DNVP): [+ h_right_coalition +]%

[? if nazi_urgency <= 1 and nsdap_hl >= 15 : The rapid rise in NSDAP votes is extremely worrying. Many had believed that the party was moribound; now, some of us consider it to be the greatest threat to democracy in Germany. ?]

[? if h_anti_democratic_coalition >= 50 : Together, the anti-democratic USPD, DNVP, and NSDAP have a majority in the Landtag. A stable governing majority will be almost impossible. ?]

There are some potential coalition arrangements.

@coalition_menu

- @grand_coalition
- @h_left_coalition
- @h_uspd_tolerated_spd_minority
- @h_spd_majority
- @h_uspd_tolerated_social_liberal_coalition
- @h_social_liberal_coalition
- @h_social_christian_coalition
- @h_weimar_coalition
- @h_uspd_tolerated_weimar_coalition
- @spd_majority
- @nsdap_majority
- @no_majority

@grand_coalition
title: A Grand Coalition, with the bourgeois parties.
subtitle: SPD + [+ ddp_name +] + DVP ([+ h_grand_coalition +]%)
view-if: h_grand_coalition >= 50 or h_elections < 1 or in_hamburg_groko
choose-if: h_grand_coalition >= 50 or ((h_elections < 1 or in_hamburg_groko) and not nsdap_hl >= 50)
on-arrival: in_hamburg_left = 0; in_hamburg_tolerated_spd = 0; in_hamburg_spd = 0; in_hamburg_tolerated_soclib: 0; in_hamburg_soclib: 0; in_hamburg_socchr: 0; in_hamburg_tolerated_weimar: 0; in_hamburg_weimar: 1; in_hamburg_groko = 1; in_hamburg_bourgeois: 0; in_hamburg_right: 0; in_hamburg_nsdap = 0; workers_spd += 1*(1-dissent)

The SPD enters a coalition with the [+ ddp_name +] and DVP. [? if h_grand_coalition < 50 : This is despite it lacking a majority. ?]

@h_left_coalition
title: A Left coalition.
subtitle: SPD + USPD ([+ h_left_coalition +]%)
view-if: h_left_coalition >= 50
choose-if: President != Hindenburg
unavailable_subtitle: The current President would immediately *Reichsexecute* such a government if it were to form.
on-arrival: in_hamburg_left = 1; in_hamburg_tolerated_spd = 0; in_hamburg_spd = 0; in_hamburg_tolerated_soclib: 0; in_hamburg_soclib: 0; in_hamburg_socchr: 0; in_hamburg_tolerated_weimar: 0; in_hamburg_weimar: 0; in_hamburg_groko = 0; in_hamburg_bourgeois: 0; in_hamburg_right: 0; in_hamburg_nsdap = 0; workers_spd += 3*(1-dissent)

The SPD enters a coalition with the USPD. [? if h_left_coalition < 50 : This is despite it lacking a majority. ?]

@h_uspd_tolerated_spd_minority
title: An SPD Minority government with USPD toleration.
subtitle: SPD + USPD ([+ h_uspd_tolerated_spd_minority +]%)
view-if: h_uspd_tolerated_spd_minority >= 50 or ( in_hamburg_spd and not nsdap_hl >= 50) or (in_hamburg_tolerated_spd and not nsdap_hl >= 50) 
choose-if: uspd_relation >= 45 and Q.hindenburg_relation >= 40 or ( in_hamburg_spd and not nsdap_hl >= 50) or (in_hamburg_tolerated_spd and not nsdap_hl >= 50) 
unavailable_subtitle: We do not have sufficient relations with either President Hindenburg or the USPD.
on-arrival: in_hamburg_left = 0; in_hamburg_tolerated_spd = 1; in_hamburg_spd = 0; in_hamburg_tolerated_soclib: 0; in_hamburg_soclib: 0; in_hamburg_socchr: 0; in_hamburg_tolerated_weimar: 0; in_hamburg_weimar: 0; in_hamburg_groko = 0; in_hamburg_bourgeois: 0; in_hamburg_right: 0; in_hamburg_nsdap = 0; workers_spd += 3*(1-dissent)

The SPD forms a minority government with the toleration of the USPD.

@spd_majority
title: An SPD Majority government at last!
view-if: spd__wl >= 50 or (in_hamburg_spd and not nsdap_hl >= 50) or (in_hamburg_tolerated_spd and not nsdap_hl >= 50) 
choose-if: reformist_strength < 50 or (in_hamburg_spd and not nsdap_hl >= 50) or (in_hamburg_tolerated_spd and not nsdap_hl >= 50) 
unavailable-subtitle: The Hamburg SPD wishes to partner with the bourgeois.
on-arrival: in_hamburg_left = 0; in_hamburg_tolerated_spd = 0; in_hamburg_spd = 1; in_hamburg_tolerated_soclib: 0; in_hamburg_soclib: 0; in_hamburg_socchr: 0; in_hamburg_tolerated_weimar: 0; in_hamburg_weimar: 0; in_hamburg_groko = 0; in_hamburg_bourgeois: 0; in_hamburg_right: 0; in_hamburg_nsdap = 0; workers_spd += 4*(1-dissent)

The SPD forms a majority government! [? if spd_wl < 50 : This is despite it lacking a majority. ?]

@h_uspd_tolerated_social_liberal_coalition
view-if: h_uspd_tolerated_social_liberal_coalition >= 50
title: A "Social-Liberal" coalition with USPD toleration.
subtitle: SPD + [+ ddp_name +] ([+ h_uspd_tolerated_social_liberal_coalition +]%)
choose-if: ddp_relation >= 45 and uspd_relation >= 45 and hindenburg_relation >= 30
unavailable_subtitle: We do not have sufficient relations with either the DDP, the USPD, or President Hindenberg.
on-arrival: in_hamburg_left = 0; in_hamburg_tolerated_spd = 0; in_hamburg_spd = 0; in_hamburg_tolerated_soclib: 1; in_hamburg_soclib: 0; in_hamburg_socchr: 0; in_hamburg_tolerated_weimar: 0; in_hamburg_weimar: 0; in_hamburg_groko = 0; in_hamburg_bourgeois: 0; in_hamburg_right: 0; in_hamburg_nsdap = 0; workers_spd += 2*(1-dissent)

The SPD enters a coalition with the [+ ddp_name +] with the toleration of the USPD. 

@h_social_liberal_coalition
title: A "Social-Liberal" coalition.
