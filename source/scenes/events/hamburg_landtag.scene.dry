subtitle: SPD + Z + [+ ddp_name +] ([+ h_uspd_tolerated_weimar_coalition +]%)
view-if: h_uspd_tolerated_weimar_coalition >= 50 or (in_hamburg_tolerated_weimar and not nsdap_hl >= 50)
choose-if: z_relation >= 45 and ddp_relation >= 45 and uspd_relation >= 50 and hindenburg_relation >= 15 or (in_hamburg_tolerated_weimar and not nsdap_hl >= 50)
