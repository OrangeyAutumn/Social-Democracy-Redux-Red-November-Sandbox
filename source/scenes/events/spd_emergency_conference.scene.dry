[+ spd_coleader_3_fullname +] wins in a victory for the Reformist faction!

- @root: The conference is concluded.

@neorevisionist_3
view-if: spd_coleader_3_faction != "neorevisionist" and neorevisionism == 3
choose-if: (neorevisionist_c >= 50) or (neorevisionist_c >= reformist_c and (reformist_c+neorevisionist_c) >= 50) or (neorevisionist_c >= reformist_c and neorevisionist_c >= labor_c and (labor_c+reformist_c+neorevisionist_c) >= 50) or (neorevisionist_leader == "Baade") or (neorevisionist_leader == "Hirschfeld") or (neorevisionist_leader == "Radbruch") or (neorevisionist_leader == "Stampfer")
on-arrival: {!

if (Q.revisionist_leader == "Mierendorff") {

    Q.spd_coleader_1 = "Mierendorff";

    Q.spd_coleader_1_fullname = "Carlo Mierendorff";

} else if (Q.revisionist_leader == "Schumacher") {

    Q.spd_coleader_1 = "Schumacher";

    Q.spd_coleader_1_fullname = "Kurt Schumacher";

} else if (Q.revisionist_leader == "Leber") {

    Q.spd_coleader_1 = "Leber";

    Q.spd_coleader_1_fullname = "Julius Leber";

} else if (Q.revisionist_leader == "Stampfer") {

    Q.spd_coleader_1 = "Stampfer";

    Q.spd_coleader_1_fullname = "Friedrich Stampfer";

} else if (Q.revisionist_leader == "Radbruch") {

    Q.spd_coleader_1 = "Radbruch";

    Q.spd_coleader_1_fullname = "Gustav Radbruch";

} else if (Q.revisionist_leader == "Hirschfeld") {

    Q.spd_coleader_1 = "Hirschfeld";

    Q.spd_coleader_1_fullname = "Magnus Hirschfeld";

} else if (Q.revisionist_leader == "Baade") {

    Q.spd_coleader_1 = "Baade";

    Q.spd_coleader_1_fullname = "Fritz Baade";

}

Q.revisionist_leader = "vacant";

Q.revisionist_leader_fullname = "vacant";

!}

