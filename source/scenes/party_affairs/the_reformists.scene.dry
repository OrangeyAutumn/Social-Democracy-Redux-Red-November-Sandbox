card-image: img/portraits/BraunOtto.jpg
view-if: reformists_leader != "Braun" and spd_coleader_1 != "Braun" and spd_coleader_2 != "Braun" and spd_coleader_3 != "Braun"
on-arrival: reformists_leader = "Braun"; reformists_leader_fullname = "Otto Braun"
